{
  "name": "@codycodeagent/cody-web-core-build",
  "version": "0.20.0",
  "private": true,
  "description": "Shared Codex protocol, runtime, and conversation primitives for CodyWeb products",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md"],
  "exports": {
    "./protocol": { "types": "./dist/protocol/index.d.ts", "import": "./dist/protocol/index.js" },
    "./runtime": { "types": "./dist/runtime/index.d.ts", "import": "./dist/runtime/index.js" },
    "./session": { "types": "./dist/session/index.d.ts", "import": "./dist/session/index.js" },
    "./conversation": { "types": "./dist/conversation/index.d.ts", "import": "./dist/conversation/index.js" },
    "./composer": { "types": "./dist/composer/index.d.ts", "import": "./dist/composer/index.js" },
    "./presentation": { "types": "./dist/presentation/index.d.ts", "import": "./dist/presentation/index.js" },
    "./client": { "types": "./dist/client/index.d.ts", "import": "./dist/client/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  }
}
