{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@codycodeagent/cody-web-core/conversation": ["../core/dist/conversation/index.d.ts"],
      "@codycodeagent/cody-web-core/composer": ["../core/dist/composer/index.d.ts"],
      "@codycodeagent/cody-web-core/presentation": ["../core/dist/presentation/index.d.ts"]
    },
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/**/*.test.ts"]
}
