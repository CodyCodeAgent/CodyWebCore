{
  "name": "@codycodeagent/cody-web-core",
  "version": "0.37.33",
  "description": "Shared Codex protocol, runtime, and conversation primitives for CodyWeb products",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "files": ["packages/core/dist", "packages/core/schema", "packages/vue/dist", "packages/vue/src/style.css", "README.md", "CHANGELOG.md", "LICENSE"],
  "exports": {
    "./protocol": { "types": "./packages/core/dist/protocol/index.d.ts", "import": "./packages/core/dist/protocol/index.js" },
    "./runtime": { "types": "./packages/core/dist/runtime/index.d.ts", "import": "./packages/core/dist/runtime/index.js" },
    "./session": { "types": "./packages/core/dist/session/index.d.ts", "import": "./packages/core/dist/session/index.js" },
    "./conversation": { "types": "./packages/core/dist/conversation/index.d.ts", "import": "./packages/core/dist/conversation/index.js" },
    "./composer": { "types": "./packages/core/dist/composer/index.d.ts", "import": "./packages/core/dist/composer/index.js" },
    "./presentation": { "types": "./packages/core/dist/presentation/index.d.ts", "import": "./packages/core/dist/presentation/index.js" },
    "./client": { "types": "./packages/core/dist/client/index.d.ts", "import": "./packages/core/dist/client/index.js" },
    "./vue": { "types": "./packages/vue/dist/index.d.ts", "import": "./packages/vue/dist/index.js" },
    "./vue/style.css": "./packages/vue/src/style.css"
  },
  "workspaces": ["packages/*"],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0"
  },
  "scripts": {
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "build": "pnpm --filter @codycodeagent/cody-web-core-build build && pnpm --filter @codycodeagent/cody-web-ui build",
    "test": "pnpm check:boundaries && pnpm --filter @codycodeagent/cody-web-core-build test && pnpm --filter @codycodeagent/cody-web-core-build build && pnpm --filter @codycodeagent/cody-web-ui test",
    "typecheck": "pnpm --filter @codycodeagent/cody-web-core-build typecheck && pnpm --filter @codycodeagent/cody-web-ui typecheck"
  }
}
